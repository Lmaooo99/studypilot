    </coordinates>
    <panel_attributes>title=SD14 Execute plans with nested bounded recovery
fontsize=14
obj=AgentController~c
obj=AgentPlanner~p
obj=ToolManager~t
obj=Service-backed Tool~s
obj=MemoryManager~m

combinedFragment=loop~request c s; p:[Initial plan plus at most two replans]
c:Trace every proposed step, then validate the plan (parsed strings are trimmed)
c-&gt;t : validatePlan(plan, results)
t.&gt;c : error or accepted plan
combinedFragment=loop~steps c s; t:[Each step until failure or clarification]
c-&gt;t : resolveStep(step, successful results)
t.&gt;c : resolved references and normalized arguments
c:Reuse an earlier equivalent action and its retry count during replanning
combinedFragment=loop~retry c s; t:[For a new action, initial call and at most two extra retries]
c-&gt;t : execute(courseId, resolvedStep)
t-&gt;s : execute(arguments with trusted courseId)
s.&gt;t : ToolResult
t.&gt;c : actual result
--
c:OK continues, INSUFFICIENT_DATA clarifies, exhausted failures stop this plan
--
c-&gt;p : replan(courseId, request, history, resultsSoFar) only for REPLAN
p.&gt;c : new plan or clarification
--
c-&gt;m : addTurn(request, actual final answer)
c:Return actual earlier results on failure, completed IDs cannot change action</panel_attributes>
    <additional_attributes />
  </element>
</diagram>